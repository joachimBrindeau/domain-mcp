{
  "name": "domain-mcp",
  "version": "3.0.0",
  "mcpName": "io.github.joachimBrindeau/domain-mcp",
  "description": "MCP server for domain management via Claude, Cursor, and any Model Context Protocol client. 108 Dynadot API actions across 13 AI-native tools for domain search, registration, renewal, DNS, WHOIS, nameservers, transfers, and aftermarket.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "domain-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "server.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joachimBrindeau/domain-mcp.git",
    "directory": "packages/domain-mcp"
  },
  "bugs": {
    "url": "https://github.com/joachimBrindeau/domain-mcp/issues"
  },
  "homepage": "https://github.com/joachimBrindeau/domain-mcp#readme",
  "author": {
    "name": "Joachim Brindeau"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "test:mcpb": "node scripts/test-mcpb.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:generate": "tsx scripts/test-with-claude-code.ts",
    "test:generate:write": "tsx scripts/test-with-claude-code.ts --write",
    "migrate:tool-names": "node scripts/migrate-tool-names.mjs",
    "check": "biome check src/ test/",
    "check:fix": "biome check --write src/ test/",
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-progress",
    "publint": "publint",
    "attw": "attw --pack --ignore-rules cjs-resolves-to-esm",
    "size": "size-limit",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "anthropic-mcp",
    "domain-mcp",
    "mcp-domain",
    "dynadot",
    "dynadot-api",
    "dynadot-mcp",
    "domain",
    "domains",
    "domain-management",
    "domain-registration",
    "domain-api",
    "dns",
    "dns-api",
    "dns-management",
    "nameserver",
    "whois",
    "domain-transfer",
    "domain-parking",
    "domain-forwarding",
    "registrar",
    "registrar-api",
    "aftermarket",
    "domain-auction",
    "ai-domain",
    "ai-agent",
    "agent-tools",
    "llm-tools",
    "claude",
    "claude-code",
    "claude-mcp-server",
    "cursor",
    "cursor-mcp",
    "natural-language-domains",
    "typescript",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ky": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/file": "^13.0.3",
    "@types/archiver": "8.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "archiver": "8.0.0",
    "dotenv": "^17.4.2",
    "publint": "^0.3.24",
    "size-limit": "^13.0.3",
    "ts-morph": "28.0.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  },
  "size-limit": [
    {
      "path": "dist/**/*.js",
      "limit": "250 kB"
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
