{
  "name": "domain-mcp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for domain-mcp (MCP server) and domain-agent-kit (Claude Code plugin).",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.26.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/joachimBrindeau/domain-mcp.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter domain-mcp run build",
    "clean": "pnpm --filter domain-mcp run clean",
    "dev": "pnpm --filter domain-mcp run dev",
    "start": "pnpm --filter domain-mcp run start",
    "test": "pnpm --filter domain-mcp run test",
    "test:watch": "pnpm --filter domain-mcp run test:watch",
    "test:coverage": "pnpm --filter domain-mcp run test:coverage",
    "typecheck": "pnpm --filter domain-mcp run typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "knip": "pnpm --filter domain-mcp run knip",
    "publint": "pnpm --filter domain-mcp run publint",
    "attw": "pnpm --filter domain-mcp run attw",
    "size": "pnpm --filter domain-mcp run size",
    "wiki:generate": "pnpm --filter domain-mcp run build && node packages/domain-mcp/scripts/wiki.mjs",
    "wiki:check": "pnpm --filter domain-mcp run build && node packages/domain-mcp/scripts/wiki.mjs --check",
    "wiki:build": "pnpm run wiki:generate && pnpm --filter domain-mcp-wiki run build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "knip": "^5.82.1",
    "lefthook": "^1.13.6",
    "typescript": "^5.9.3"
  }
}
